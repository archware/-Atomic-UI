    {
      "symbol": "authInterceptor",
      "source": "src/app/shared/ui/interceptors/auth.interceptor.ts",
      "reason": "La política de autenticación HTTP pertenece al consumidor."
    },
    {
      "symbol": "cacheInterceptor",
      "source": "src/app/shared/ui/interceptors/cache.interceptor.ts",
      "reason": "La estrategia de caché depende de los contratos API de cada aplicación."
    },
    {
      "symbol": "PermissionDirective",
      "source": "src/app/shared/ui/directives/permission.directive.ts",
