{
  "name": "atomic-ui",
  "version": "5.11.0",
  "type": "module",
  "author": "COTAHA",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run check:css-values",
    "build": "ng build",
    "prebuild:prod": "npm run check:css-values",
    "build:prod": "ng build --configuration production --base-href /-Atomic-UI/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:angular-scrollable-table": "node dist/angular-scrollable-table/server/server.mjs",
    "lint": "ng lint",
    "storybook": "ng run angular-scrollable-table:storybook",
    "build-storybook": "ng run angular-scrollable-table:build-storybook",
    "predeploy": "npm run build:prod && npm run build-storybook && node scripts/combine-builds.cjs",
    "deploy": "npx angular-cli-ghpages --dir=dist/gh-pages",
    "deploy:app": "ng build --configuration production --base-href /-Atomic-UI/ && npx angular-cli-ghpages --dir=dist/angular-scrollable-table/browser",
    "deploy:storybook": "npm run build-storybook && npx angular-cli-ghpages --dir=storybook-static",
    "lib:build": "ng build atomic-ui && node tools/copy-lib-tokens.cjs",
    "lib:link": "npm link",
    "lib:unlink": "npm unlink atomic-ui",
    "dev:components": "ng run angular-scrollable-table:storybook",
    "dev:full": "concurrently \"npm run storybook\" \"npm run watch\"",
    "docs": "npx compodoc -p tsconfig.json -s",
    "docs:json": "npx compodoc -p tsconfig.json -e json -d .",
    "create:project": "node tools/create-project.js",
    "catalog:query": "node tools/query-atomic-catalog.js",
    "catalog:check": "node tools/check-atomic-catalog.js --strict-references",
    "tokens:check": "node tools/run-powershell.cjs scripts/audit-tokens.ps1 -ComponentGlob src/app/shared/ui -Json",
    "tokens:sizes:test": "node tools/test-semantic-size-tokens.js",
    "agent:context": "node tools/build-agent-context.js",
    "generate:ui": "node tools/generate-ui.js",
    "tooling:test": "node tools/test-atomic-catalog.js && node tools/test-atomic-blueprints.js && node tools/test-audit-tokens.js && npm run tokens:sizes:test && node tools/test-ui-generator.js",
    "quality:check": "npm run governance:check && npm run lint && npm test -- --watch=false && npm run build && npm run build-storybook",
    "governance:install": "node tools/install-consumer-governance.js",
    "governance:test": "node tools/test-consumer-governance.js",
    "governance:smoke": "node tools/test-project-generator.js",
    "check:selectors": "node tools/check-selector-prefixes.cjs",
    "check:css-values": "node tools/check-invalid-css-values.js",
    "package:test": "node tools/test-package-distribution.js",
    "package:manifest": "node tools/check-package-distribution.js manifest",
    "package:dry-run": "node tools/check-package-distribution.js dry-run",
    "package:check": "npm run package:test && node tools/check-package-distribution.js check",
    "governance:check": "npm run governance:test && npm run governance:smoke && node tools/check-atomic-blueprints.js && npm run catalog:check && npm run check:catalog-api && npm run tokens:check && npm run tooling:test && npm run check:selectors && npm run check:css-values && npm run package:check && npm run check:contrast && npm run check:focus",
    "check:contrast": "node scripts/check-theme-contrast.mjs",
    "check:focus": "node scripts/check-focus-selectors.mjs",
    "check:catalog-api": "node tools/check-catalog-api.cjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@angular-devkit/build-angular": {
      "postcss": "8.5.26"
    },
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "less": "4.8.1",
    "vite": "7.3.6",
    "webpack-dev-server": "5.2.6",
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/ssr": "^22.1.3",
    "@fontsource/open-sans": "^5.2.7",
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "express": "^5.1.0",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2201.3",
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular-devkit/core": "^22.1.3",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@angular/platform-browser-dynamic": "^22.1.1",
    "@compodoc/compodoc": "^2.0.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-onboarding": "^10.5.3",
    "@storybook/angular": "^10.5.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "ajv": "^8.20.0",
    "angular-cli-ghpages": "^3.1.0",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "^10.5.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.1",
    "postcss": "^8.5.26",
    "storybook": "^10.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.64.0"
  }
}
