{
  "$schema": "../../catalog/schemas/ui-requirement.schema.json",
  "schemaVersion": 1,
  "id": "atomic.fixture.relationship.modal.ui-only",
  "recipe": "modal-catalog",
  "feature": {
    "key": "relationship",
    "className": "Relationship",
    "selector": "prest-relationship-page",
    "title": "Parentescos",
    "singular": "parentesco",
    "plural": "parentescos"
  },
  "model": {
    "name": "Relationship",
    "id": {
      "name": "id",
      "type": "number"
    },
    "fields": [
      {
        "name": "code",
        "type": "string",
        "label": "Código",
        "initialValue": "",
        "required": true,
        "maxLength": 20
      },
      {
        "name": "name",
        "type": "string",
        "label": "Nombre",
        "initialValue": "",
        "required": true,
        "maxLength": 50
      },
      {
        "name": "priority",
        "type": "number",
        "label": "Prioridad",
        "initialValue": 0,
        "minimum": 0,
        "maximum": 9999,
        "step": 1,
        "required": true
      },
      {
        "name": "active",
        "type": "boolean",
        "label": "Estado",
        "initialValue": true
      }
    ]
  },
  "table": {
    "pageSize": 10,
    "columns": [
      {
        "field": "code",
        "header": "Código",
        "sortable": true
      },
      {
        "field": "name",
        "header": "Parentesco",
        "sortable": true
      },
      {
        "field": "priority",
        "header": "Prioridad",
        "sortable": true
      },
      {
        "field": "active",
        "header": "Estado",
        "sortable": true
      }
    ]
  },
  "editor": {
    "fields": ["code", "name", "priority", "active"]
  },
  "variants": {
    "density": "compact",
    "editorSize": "md",
    "formLayout": "two-columns",
    "actionDisplay": "inline"
  },
  "actions": [
    {
      "operation": "delete",
      "location": "row",
      "label": "Eliminar parentesco",
      "permissionKey": "relationships.delete",
      "confirmation": {
        "title": "Eliminar parentesco",
        "message": "Esta acción eliminará el parentesco seleccionado.",
        "confirmLabel": "Eliminar",
        "cancelLabel": "Conservar"
      }
    }
  ],
  "contract": {
    "mode": "ui-only",
    "capabilities": ["list", "create", "update", "delete"]
  }
}
